# Copy to .env.music-bot before running compose.music-bot.yaml.
# Generate a strong random secret with: openssl rand -hex 32
MUSIC_BOT_API_SECRET=

# Internal LiveKit signaling URL on the backspace-home Docker bridge (tailscale container IP).
MUSIC_BOT_LIVEKIT_URL=ws://10.253.245.2:7880

# Display name shown on the bot tile in voice channels.
MUSIC_BOT_DISPLAY_NAME=음악 봇

# Maximum allowed single-track duration in seconds (default: 3 hours).
MUSIC_BOT_MAX_DURATION_SECONDS=10800
MUSIC_BOT_LOG_LEVEL=INFO
